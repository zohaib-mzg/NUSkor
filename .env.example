# Supabase (public/publishable — safe to expose in the frontend)
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google OAuth Client ID (public — used only for the "Sign in with Google" button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Full site URL — local dev or your deployment.
# Production: use your custom nuSkor domain (no trailing slash) — AdSense does
# not approve *.vercel.app domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Public site ──────────────────────────────────────────────────────────────
# nuSkor's OWN contact address shown on /contact and elsewhere — never a
# university address.
NEXT_PUBLIC_CONTACT_EMAIL=admin@nuskor.app
# Optional Google Search Console verification token (meta tag content value)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Google AdSense (public pages only — see src/components/public/AdSlot.tsx) ─
# Leave these empty to keep all ads disabled (AdSlot renders nothing).
# Client format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Slot IDs (numbers only) for each placement variant
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is used by the browser client.
# VAPID_PRIVATE_KEY and VAPID_SUBJECT are server-only — used by the
# send-push-notification Edge Function (set as Supabase secrets).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:admin@nuskor.app

# NEVER add the Supabase service_role key or the Google Client Secret here.
